# Copie este arquivo para .env e adicione sua chave:
# cp .env.example .env

GEMINI_API_KEY=sua-chave-aqui
# ---
# Gemini model options (uncomment one to use):
# Gemini 2.5 pro is the default model, in case none of the below is uncommented.
# ---
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-pro-latest

GEMINI_TEMPERATURE=0.4

# Opcional: sincronização automática de heurísticas via API
# Exemplo:
# BASE_API_URL=https://sua-api.com
# API_KEY=sua-chave-da-api-de-heuristicas
BASE_API_URL=
API_KEY=
